#!/usr/bin/env bash
# cpod — run Claude Code in an isolated container tied to the current repo.
# Repo: claude-pod. See docs/ for the full technology write-up.
set -euo pipefail

# ---- locate install root & load libs -----------------------------------------
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
CPOD_HOME="$(dirname "$(dirname "$SELF")")"
LIB="${CPOD_HOME}/lib"
# shellcheck source=/dev/null
for m in log runtime mounts gpu dind deploykey container; do . "${LIB}/${m}.sh"; done

# ---- defaults ----------------------------------------------------------------
CPOD_STATE="${CLAUDE_POD_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/claude-pod}"
CPOD_RUNTIME=""
CPOD_PROFILE="default"    # default | guarded | locked (a trust-level preset of the flags below)
CPOD_KEY_MODE="rw"        # rw | ro | none
CPOD_KEY_FILE=0
CPOD_RUN_CLAUDE=0
CPOD_RUN_CMD=""
CPOD_INHERIT_ENV=0
CPOD_EXTRA_ENV=()
CPOD_CLAUDE_HARDENED=0
CPOD_ROOT=1               # --root/--no-root: passwordless sudo in the pod (on in the default profile)
CPOD_NET_HOST=0
CPOD_AUTO_PROXY=0         # --proxy: forward+resolve the host http(s)_proxy into the pod (off by default)
CPOD_PORTS=()
CPOD_VOLUMES=()           # extra -v/--volume bind mounts and named volumes
CPOD_CACHE_VOL=0          # --cache-volume: per-project persistent ~/.cache
CPOD_RM=0                 # --rm: tear the container down when the session ends
CPOD_DOWN_VOLUMES=0       # down --volumes: also remove the cache volume
CPOD_LOGS_FOLLOW=0        # logs -f/--follow
CPOD_PASSTHRU=()          # everything after `exec` — the command to run
CPOD_GPU="auto"           # auto | on | off
CPOD_DIND="auto"          # auto | on | off
CPOD_DIND_EXPLICIT=0
CPOD_ALL=0
CPOD_REBUILD=0
CPOD_BASE_IMAGE="${CPOD_BASE_IMAGE:-nvidia/cuda:12.6.2-runtime-ubuntu24.04}"
RUN_ARGS=()

# host identity — mirrored into the container so bind-mount ownership & ~/.claude line up
HOST_HOME="$HOME"; CONTAINER_HOME="$HOME"
HOST_USER="$(id -un)"; HOST_UID="$(id -u)"; HOST_GID="$(id -g)"
CPOD_GIT_NAME="$(git config --global user.name  2>/dev/null || true)"
CPOD_GIT_EMAIL="$(git config --global user.email 2>/dev/null || true)"
PROJECT_DIR="$(pwd -P)"

usage() {
  cat >&2 <<EOF
${_C_BLU}cpod${_C_RST} — Claude Code in an isolated container tied to the current repo (repo: claude-pod)

${_C_GRN}Commands:${_C_RST}
  up            create and start a new container, enter a shell        (scenario 1)
  start         start a previously created (stopped) container         (scenario 2)
  attach|shell  connect to an already running container (new session)  (scenario 3)
  restart       restart this project's container, then enter a shell
  exec <cmd>    run a one-off command in the running container (no new container)
  logs [-f]     show the container's logs (-f/--follow to stream)
  inspect       low-level details of the container (runtime inspect)
  stop          stop the container (without removing it)
  down          stop, remove the container and REVOKE the deploy key
                (add --volumes to also drop the cache volume)
  prune         remove STOPPED cpod containers (this project, or --all),
                revoking their deploy keys
  ls|list       list containers for this project (or --all for every one)
  status        status of this project's container
  build         build the image (without starting; --rebuild to rebuild)
  (no command)  smart mode: none -> up, stopped -> start, running -> attach

${_C_GRN}Trust profiles (presets; any explicit flag still overrides):${_C_RST}
  --profile default   (default) key rw, ~/.claude rw, docker auto, root (sudo) ON
  --profile guarded   key ro, --claude-hardened, no docker, root OFF (no-new-privileges)
  --profile locked    key none, --claude-hardened, no docker, --rm, root OFF (no-new-privileges)

${_C_GRN}Key (git access to GitHub), modes:${_C_RST}
  --key rw      (default) dedicated deploy key with PUSH rights to THIS repo only
  --key ro      read-only deploy key — push is rejected
  --key none    no key: work on the local copy only
  --key-file    deliver the key as a file (ro) instead of ssh-agent (default: ssh-agent)

${_C_GRN}Other flags:${_C_RST}
  --claude              run claude immediately on entry (otherwise a shell)
  --run "<cmd>"         run a command on entry instead of a shell
  --claude-hardened     mount executable ~/.claude config (settings*/plugins/agents/
                        skills/commands/hooks) read-only — protects the host from a planted hook
  --inherit-env         forward all host environment variables (except secrets)
  --env KEY[=VAL]       forward a single variable (repeatable)
  -p, --port SPEC       publish a port (docker-style, e.g. 8080:80, 127.0.0.1:8080:80/tcp); repeatable
  -v, --volume SPEC     extra bind mount or named volume (HOST:CONT[:opts] or NAME:CONT[:opts]); repeatable
  --cache-volume        mount a persistent per-project named volume at ~/.cache (survives recreation)
  --rm                  remove the container when the session ends (ephemeral)
  --root | --no-root    passwordless sudo in the pod for apt/setup (ON in default profile;
                        --no-root instead adds no-new-privileges, blocking SUID escalation)
  --proxy               forward + resolve the host http(s)_proxy into the pod (OFF by default;
                        without it the pod uses direct network — better for apt/git/setup)
  --net-host            host network (needed for a localhost proxy on rootless podman; weakens isolation)
  --gpu | --no-gpu      force GPU on/off (default: autodetect)
  --docker | --no-docker  enable/disable docker socket passthrough (default: auto per project)
  --runtime podman|docker  pick the runtime (default: podman, else docker)
  --rebuild             rebuild the image
  --all                 (for ls) show containers of all projects
  -h | --help           this help

${_C_GRN}Examples:${_C_RST}
  cpod                              # smart mode — create / start / attach as needed
  cpod up --claude                  # create the pod and launch claude immediately
  cpod exec claude -p "run tests"   # one-off headless claude in the running pod
  cpod up --profile guarded         # semi-trusted code: read-only key, hardened config
  cpod up --profile locked          # untrusted code: no key, hardened, disposable (--rm)
  cpod up -v ~/datasets:/data:ro    # mount an extra host directory read-only
  cpod up --cache-volume            # persist ~/.cache (uv/pip/npm) across recreation
  cpod up -p 8080:80                # publish a port to the host
  cpod up --net-host                # share the host network (e.g. to reach a localhost proxy)
  cpod up --run "pytest -q"         # run a command on entry instead of a shell
  cpod exec bash -lc "ruff check ." # run a quick command without a new pod
  cpod logs -f                      # follow the pod's logs
  cpod down --volumes               # remove the pod, revoke the key, drop the cache volume
  cpod prune --all                  # clean up stopped pods across all projects

${_C_GRN}Recommendations:${_C_RST}
  Pick a profile by how much you trust the code:
    your own repo ........... (default)         full convenience, push allowed
    a PR / dependency ....... --profile guarded  read-only key, ~/.claude hardened
    untrusted / auditing .... --profile locked   no key, hardened, disposable pod
  Git access: keep --key rw only for repos you own — it allows push AND force-push to
    THIS repo. To review code you won't push, use --key ro or --key none.
  Runtime: rootless podman is the safest default; docker is auto-picked if podman is
    absent. Override with --runtime podman|docker.
  Isolation: for untrusted code avoid --net-host, --docker and --inherit-env — each one
    widens the attack surface. See the security model before relaxing them.
  Housekeeping: 'cpod down' revokes the deploy key and cleans up — don't leave pods
    lingering; 'cpod prune' clears stopped ones in bulk.

Details and security model: ${CPOD_HOME}/docs/
EOF
}

# ---- profiles ----------------------------------------------------------------
# A --profile seeds trust-level defaults for the other flags. It is resolved BEFORE
# the main parse loop so any explicit flag (wherever it appears) overrides the preset.
#   default  key=rw    claude=rw        docker=auto  root(sudo)=on
#   guarded  key=ro    claude=hardened  docker=off   root=off  (no-new-privileges on)
#   locked   key=none  claude=hardened  docker=off   root=off  (no-new-privileges on) --rm
# root=on means passwordless sudo in the pod (convenient install/setup); root=off adds
# no-new-privileges (SUID can't escalate) instead. A network egress allowlist is
# intentionally NOT part of any profile — see docs/SECURITY.md for why.
apply_profile() {
  case "$1" in
    default|"") CPOD_PROFILE="default"; CPOD_ROOT=1 ;;
    guarded)
      CPOD_PROFILE="guarded"
      CPOD_KEY_MODE="ro"; CPOD_CLAUDE_HARDENED=1; CPOD_ROOT=0
      CPOD_DIND="off"; CPOD_DIND_EXPLICIT=1; CPOD_NET_HOST=0 ;;
    locked)
      CPOD_PROFILE="locked"
      CPOD_KEY_MODE="none"; CPOD_CLAUDE_HARDENED=1; CPOD_ROOT=0
      CPOD_DIND="off"; CPOD_DIND_EXPLICIT=1; CPOD_NET_HOST=0; CPOD_RM=1 ;;
    *) log_error "unknown --profile: '$1' (use default|guarded|locked)"; usage; exit 2 ;;
  esac
}

for ((_i=1; _i<=$#; _i++)); do
  case "${!_i}" in
    --profile)   _j=$((_i+1)); apply_profile "${!_j:-}" ;;
    --profile=*) apply_profile "${!_i#*=}" ;;
  esac
done

# ---- parse args --------------------------------------------------------------
CMD=""
while [ $# -gt 0 ]; do
  case "$1" in
    up|start|attach|shell|ls|list|down|stop|status|build|restart|logs|inspect|prune)
      [ -z "$CMD" ] || { log_error "unexpected extra command: $1"; usage; exit 2; }
      CMD="$1"; shift ;;
    exec)
      [ -z "$CMD" ] || { log_error "unexpected extra command: $1"; usage; exit 2; }
      CMD="exec"; shift; CPOD_PASSTHRU=( "$@" ); break ;;   # rest is the command, verbatim
    help|-h|--help) CMD="help"; shift ;;
    --runtime)      CPOD_RUNTIME="${2:-}"; shift 2 ;;
    --runtime=*)    CPOD_RUNTIME="${1#*=}"; shift ;;
    --profile)      shift 2 ;;   # already applied in the pre-scan above
    --profile=*)    shift ;;
    --key)          CPOD_KEY_MODE="${2:-}"; shift 2 ;;
    --key=*)        CPOD_KEY_MODE="${1#*=}"; shift ;;
    --key-file)     CPOD_KEY_FILE=1; shift ;;
    --claude)       CPOD_RUN_CLAUDE=1; shift ;;
    --run)          CPOD_RUN_CMD="${2:-}"; shift 2 ;;
    --run=*)        CPOD_RUN_CMD="${1#*=}"; shift ;;
    --inherit-env)  CPOD_INHERIT_ENV=1; shift ;;
    --claude-hardened) CPOD_CLAUDE_HARDENED=1; shift ;;
    --env)          CPOD_EXTRA_ENV+=("${2:-}"); shift 2 ;;
    --env=*)        CPOD_EXTRA_ENV+=("${1#*=}"); shift ;;
    -p|--port)      CPOD_PORTS+=("${2:-}"); shift 2 ;;
    -p=*|--port=*)  CPOD_PORTS+=("${1#*=}"); shift ;;
    -v|--volume)    CPOD_VOLUMES+=("${2:-}"); shift 2 ;;
    -v=*|--volume=*) CPOD_VOLUMES+=("${1#*=}"); shift ;;
    --cache-volume) CPOD_CACHE_VOL=1; shift ;;
    --rm)           CPOD_RM=1; shift ;;
    --volumes)      CPOD_DOWN_VOLUMES=1; shift ;;
    -f|--follow)    CPOD_LOGS_FOLLOW=1; shift ;;
    --net-host|--network-host) CPOD_NET_HOST=1; shift ;;
    --proxy|--auto-proxy) CPOD_AUTO_PROXY=1; shift ;;
    --root)         CPOD_ROOT=1; shift ;;
    --no-root)      CPOD_ROOT=0; shift ;;
    --gpu)          CPOD_GPU=on; shift ;;
    --no-gpu)       CPOD_GPU=off; shift ;;
    --docker)       CPOD_DIND=on;  CPOD_DIND_EXPLICIT=1; shift ;;
    --no-docker)    CPOD_DIND=off; CPOD_DIND_EXPLICIT=1; shift ;;
    --all|-a)       CPOD_ALL=1; shift ;;
    --rebuild)      CPOD_REBUILD=1; shift ;;
    --)             shift; break ;;
    -*)             log_error "unknown flag: $1"; usage; exit 2 ;;
    *)              log_error "unknown argument: $1"; usage; exit 2 ;;
  esac
done

if [ "$CMD" = "help" ]; then usage; exit 0; fi

case "$CPOD_KEY_MODE" in rw|ro|none) ;; *) log_error "--key must be rw|ro|none (got: '$CPOD_KEY_MODE')"; usage; exit 2 ;; esac

rt_detect
mkdir -p "${CPOD_STATE}/containers"
chmod 700 "${CPOD_STATE}" 2>/dev/null || true   # state holds ephemeral keys/sockets/meta

case "${CMD:-default}" in
  up)            cmd_up ;;
  start)         cmd_start ;;
  attach|shell)  cmd_attach ;;
  restart)       cmd_restart ;;
  exec)          cmd_exec ;;
  logs)          cmd_logs ;;
  inspect)       cmd_inspect ;;
  stop)          cmd_stop ;;
  down)          cmd_down ;;
  prune)         cmd_prune ;;
  ls|list)       cmd_ls ;;
  status)        cmd_status ;;
  build)         image_ensure ;;
  default)       cmd_default ;;
  *)             usage; exit 2 ;;
esac
