#!/usr/bin/env bash
# cpod — run Claude Code in an isolated container tied to the current repo.
# Repo: claude-pod. See docs/ for the full technology write-up.
set -euo pipefail

# ---- locate install root & load libs -----------------------------------------
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
CPOD_HOME="$(dirname "$(dirname "$SELF")")"
LIB="${CPOD_HOME}/lib"
# shellcheck source=/dev/null
for m in log runtime mounts gpu dind deploykey container; do . "${LIB}/${m}.sh"; done

# ---- defaults ----------------------------------------------------------------
CPOD_STATE="${CLAUDE_POD_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/claude-pod}"
CPOD_RUNTIME=""
CPOD_KEY_MODE="rw"        # rw | ro | none
CPOD_KEY_FILE=0
CPOD_RUN_CLAUDE=0
CPOD_RUN_CMD=""
CPOD_INHERIT_ENV=0
CPOD_EXTRA_ENV=()
CPOD_CLAUDE_HARDENED=0
CPOD_NET_HOST=0
CPOD_PORTS=()
CPOD_GPU="auto"           # auto | on | off
CPOD_DIND="auto"          # auto | on | off
CPOD_DIND_EXPLICIT=0
CPOD_ALL=0
CPOD_REBUILD=0
CPOD_BASE_IMAGE="${CPOD_BASE_IMAGE:-nvidia/cuda:12.6.2-runtime-ubuntu24.04}"
RUN_ARGS=()

# host identity — mirrored into the container so bind-mount ownership & ~/.claude line up
HOST_HOME="$HOME"; CONTAINER_HOME="$HOME"
HOST_USER="$(id -un)"; HOST_UID="$(id -u)"; HOST_GID="$(id -g)"
CPOD_GIT_NAME="$(git config --global user.name  2>/dev/null || true)"
CPOD_GIT_EMAIL="$(git config --global user.email 2>/dev/null || true)"
PROJECT_DIR="$(pwd -P)"

usage() {
  cat >&2 <<EOF
${_C_BLU}cpod${_C_RST} — Claude Code in an isolated container tied to the current repo (repo: claude-pod)

${_C_GRN}Commands:${_C_RST}
  up            create and start a new container, enter a shell        (scenario 1)
  start         start a previously created (stopped) container         (scenario 2)
  attach|shell  connect to an already running container (new session)  (scenario 3)
  stop          stop the container (without removing it)
  down          stop, remove the container and REVOKE the deploy key
  ls|list       list containers for this project (or --all for every one)
  status        status of this project's container
  build         build the image (without starting; --rebuild to rebuild)
  (no command)  smart mode: none -> up, stopped -> start, running -> attach

${_C_GRN}Key (git access to GitHub), modes:${_C_RST}
  --key rw      (default) dedicated deploy key with PUSH rights to THIS repo only
  --key ro      read-only deploy key — push is rejected
  --key none    no key: work on the local copy only
  --key-file    deliver the key as a file (ro) instead of ssh-agent (default: ssh-agent)

${_C_GRN}Other flags:${_C_RST}
  --claude              run claude immediately on entry (otherwise a shell)
  --run "<cmd>"         run a command on entry instead of a shell
  --claude-hardened     mount executable ~/.claude config (settings*/plugins/agents/
                        skills/commands/hooks) read-only — protects the host from a planted hook
  --inherit-env         forward all host environment variables (except secrets)
  --env KEY[=VAL]       forward a single variable (repeatable)
  -p, --port SPEC       publish a port (docker-style, e.g. 8080:80, 127.0.0.1:8080:80/tcp); repeatable
  --net-host            host network (handy for proxies; weakens isolation; ignores -p)
  --gpu | --no-gpu      force GPU on/off (default: autodetect)
  --docker | --no-docker  enable/disable docker socket passthrough (default: auto per project)
  --runtime podman|docker  pick the runtime (default: podman, else docker)
  --rebuild             rebuild the image
  --all                 (for ls) show containers of all projects
  -h | --help           this help

Details and security model: ${CPOD_HOME}/docs/
EOF
}

# ---- parse args --------------------------------------------------------------
CMD=""
while [ $# -gt 0 ]; do
  case "$1" in
    up|start|attach|shell|ls|list|down|stop|status|build)
      [ -z "$CMD" ] || { log_error "unexpected extra command: $1"; usage; exit 2; }
      CMD="$1"; shift ;;
    help|-h|--help) CMD="help"; shift ;;
    --runtime)      CPOD_RUNTIME="${2:-}"; shift 2 ;;
    --runtime=*)    CPOD_RUNTIME="${1#*=}"; shift ;;
    --key)          CPOD_KEY_MODE="${2:-}"; shift 2 ;;
    --key=*)        CPOD_KEY_MODE="${1#*=}"; shift ;;
    --key-file)     CPOD_KEY_FILE=1; shift ;;
    --claude)       CPOD_RUN_CLAUDE=1; shift ;;
    --run)          CPOD_RUN_CMD="${2:-}"; shift 2 ;;
    --run=*)        CPOD_RUN_CMD="${1#*=}"; shift ;;
    --inherit-env)  CPOD_INHERIT_ENV=1; shift ;;
    --claude-hardened) CPOD_CLAUDE_HARDENED=1; shift ;;
    --env)          CPOD_EXTRA_ENV+=("${2:-}"); shift 2 ;;
    --env=*)        CPOD_EXTRA_ENV+=("${1#*=}"); shift ;;
    -p|--port)      CPOD_PORTS+=("${2:-}"); shift 2 ;;
    -p=*|--port=*)  CPOD_PORTS+=("${1#*=}"); shift ;;
    --net-host|--network-host) CPOD_NET_HOST=1; shift ;;
    --gpu)          CPOD_GPU=on; shift ;;
    --no-gpu)       CPOD_GPU=off; shift ;;
    --docker)       CPOD_DIND=on;  CPOD_DIND_EXPLICIT=1; shift ;;
    --no-docker)    CPOD_DIND=off; CPOD_DIND_EXPLICIT=1; shift ;;
    --all|-a)       CPOD_ALL=1; shift ;;
    --rebuild)      CPOD_REBUILD=1; shift ;;
    --)             shift; break ;;
    -*)             log_error "unknown flag: $1"; usage; exit 2 ;;
    *)              log_error "unknown argument: $1"; usage; exit 2 ;;
  esac
done

if [ "$CMD" = "help" ]; then usage; exit 0; fi

case "$CPOD_KEY_MODE" in rw|ro|none) ;; *) log_error "--key must be rw|ro|none (got: '$CPOD_KEY_MODE')"; usage; exit 2 ;; esac

rt_detect
mkdir -p "${CPOD_STATE}/containers"
chmod 700 "${CPOD_STATE}" 2>/dev/null || true   # state holds ephemeral keys/sockets/meta

case "${CMD:-default}" in
  up)            cmd_up ;;
  start)         cmd_start ;;
  attach|shell)  cmd_attach ;;
  stop)          cmd_stop ;;
  down)          cmd_down ;;
  ls|list)       cmd_ls ;;
  status)        cmd_status ;;
  build)         image_ensure ;;
  default)       cmd_default ;;
  *)             usage; exit 2 ;;
esac
