#!/usr/bin/env bash
# cpod — run Claude Code in an isolated container tied to the current repo.
# Repo: claude-pod. See docs/ for the full technology write-up.
set -euo pipefail

# ---- locate install root & load libs -----------------------------------------
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
CPOD_HOME="$(dirname "$(dirname "$SELF")")"
LIB="${CPOD_HOME}/lib"
# shellcheck source=/dev/null
for m in log runtime mounts gpu dind deploykey container; do . "${LIB}/${m}.sh"; done

# ---- defaults ----------------------------------------------------------------
CPOD_STATE="${CLAUDE_POD_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/claude-pod}"
CPOD_RUNTIME=""
CPOD_KEY_MODE="rw"        # rw | ro | none
CPOD_KEY_FILE=0
CPOD_RUN_CLAUDE=0
CPOD_RUN_CMD=""
CPOD_INHERIT_ENV=0
CPOD_EXTRA_ENV=()
CPOD_CLAUDE_HARDENED=0
CPOD_NET_HOST=0
CPOD_GPU="auto"           # auto | on | off
CPOD_DIND="auto"          # auto | on | off
CPOD_DIND_EXPLICIT=0
CPOD_ALL=0
CPOD_REBUILD=0
CPOD_BASE_IMAGE="${CPOD_BASE_IMAGE:-nvidia/cuda:12.6.2-runtime-ubuntu24.04}"
RUN_ARGS=()

# host identity — mirrored into the container so bind-mount ownership & ~/.claude line up
HOST_HOME="$HOME"; CONTAINER_HOME="$HOME"
HOST_USER="$(id -un)"; HOST_UID="$(id -u)"; HOST_GID="$(id -g)"
CPOD_GIT_NAME="$(git config --global user.name  2>/dev/null || true)"
CPOD_GIT_EMAIL="$(git config --global user.email 2>/dev/null || true)"
PROJECT_DIR="$(pwd -P)"

usage() {
  cat >&2 <<EOF
${_C_BLU}cpod${_C_RST} — Claude Code в изолированном контейнере под текущий репозиторий (repo: claude-pod)

${_C_GRN}Команды:${_C_RST}
  up            создать и запустить новый контейнер, войти в shell        (сценарий 1)
  start         запустить ранее созданный (остановленный) контейнер       (сценарий 2)
  attach|shell  подключиться к уже работающему контейнеру (новая сессия)  (сценарий 3)
  stop          остановить контейнер (не удаляя)
  down          остановить, удалить контейнер и ОТОЗВАТЬ deploy key
  ls|list       список контейнеров для этого проекта (или --all для всех)
  status        состояние контейнера текущего проекта
  build         собрать образ (без запуска; --rebuild — пересобрать)
  (без команды) умный режим: нет → up, остановлен → start, работает → attach

${_C_GRN}Ключ (git-доступ к GitHub), режимы:${_C_RST}
  --key rw      (по умолчанию) отдельный deploy key с ПРАВОМ PUSH только в этот репо
  --key ro      deploy key только на чтение — push запрещён
  --key none    без ключа: работа только с локальной копией
  --key-file    доставить ключ файлом (ro) вместо ssh-agent (по умолчанию — ssh-agent)

${_C_GRN}Прочие флаги:${_C_RST}
  --claude              сразу запустить claude при входе (иначе — shell)
  --run "<cmd>"         выполнить команду при входе вместо shell
  --claude-hardened     смонтировать исполняемую конфигурацию ~/.claude (settings*/plugins/
                        agents/skills/commands/hooks) read-only — защита хоста от подсадки hook
  --inherit-env         пробросить все переменные среды хоста (кроме секретов)
  --env KEY[=VAL]       пробросить одну переменную (можно повторять)
  --net-host            сеть хоста (удобно для прокси; ослабляет изоляцию)
  --gpu | --no-gpu      принудительно вкл/выкл GPU (по умолчанию — автодетект)
  --docker | --no-docker  вкл/выкл проброс docker-сокета (по умолчанию — авто по проекту)
  --runtime podman|docker  выбрать runtime (по умолчанию: podman, иначе docker)
  --rebuild             пересобрать образ
  --all                 (для ls) показать контейнеры всех проектов
  -h | --help           эта справка

Подробности и модель безопасности: ${CPOD_HOME}/docs/
EOF
}

# ---- parse args --------------------------------------------------------------
CMD=""
while [ $# -gt 0 ]; do
  case "$1" in
    up|start|attach|shell|ls|list|down|stop|status|build)
      [ -z "$CMD" ] || { log_error "лишняя команда: $1"; usage; exit 2; }
      CMD="$1"; shift ;;
    help|-h|--help) CMD="help"; shift ;;
    --runtime)      CPOD_RUNTIME="${2:-}"; shift 2 ;;
    --runtime=*)    CPOD_RUNTIME="${1#*=}"; shift ;;
    --key)          CPOD_KEY_MODE="${2:-}"; shift 2 ;;
    --key=*)        CPOD_KEY_MODE="${1#*=}"; shift ;;
    --key-file)     CPOD_KEY_FILE=1; shift ;;
    --claude)       CPOD_RUN_CLAUDE=1; shift ;;
    --run)          CPOD_RUN_CMD="${2:-}"; shift 2 ;;
    --run=*)        CPOD_RUN_CMD="${1#*=}"; shift ;;
    --inherit-env)  CPOD_INHERIT_ENV=1; shift ;;
    --claude-hardened) CPOD_CLAUDE_HARDENED=1; shift ;;
    --env)          CPOD_EXTRA_ENV+=("${2:-}"); shift 2 ;;
    --env=*)        CPOD_EXTRA_ENV+=("${1#*=}"); shift ;;
    --net-host|--network-host) CPOD_NET_HOST=1; shift ;;
    --gpu)          CPOD_GPU=on; shift ;;
    --no-gpu)       CPOD_GPU=off; shift ;;
    --docker)       CPOD_DIND=on;  CPOD_DIND_EXPLICIT=1; shift ;;
    --no-docker)    CPOD_DIND=off; CPOD_DIND_EXPLICIT=1; shift ;;
    --all|-a)       CPOD_ALL=1; shift ;;
    --rebuild)      CPOD_REBUILD=1; shift ;;
    --)             shift; break ;;
    -*)             log_error "неизвестный флаг: $1"; usage; exit 2 ;;
    *)              log_error "неизвестный аргумент: $1"; usage; exit 2 ;;
  esac
done

if [ "$CMD" = "help" ]; then usage; exit 0; fi

case "$CPOD_KEY_MODE" in rw|ro|none) ;; *) log_error "--key должен быть rw|ro|none (дано: '$CPOD_KEY_MODE')"; usage; exit 2 ;; esac

rt_detect
mkdir -p "${CPOD_STATE}/containers"
chmod 700 "${CPOD_STATE}" 2>/dev/null || true   # state holds ephemeral keys/sockets/meta

case "${CMD:-default}" in
  up)            cmd_up ;;
  start)         cmd_start ;;
  attach|shell)  cmd_attach ;;
  stop)          cmd_stop ;;
  down)          cmd_down ;;
  ls|list)       cmd_ls ;;
  status)        cmd_status ;;
  build)         image_ensure ;;
  default)       cmd_default ;;
  *)             usage; exit 2 ;;
esac
